import type {CaseView,AccountingCheckView} from './types.mts';
export const escape=(value:unknown)=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
const e=escape;
export const amount=(v:string)=>v==='—'?'—':Number(v).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
export const timestamp=(v:string)=>Number.isFinite(Date.parse(v))?new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit',timeZoneName:'short',hourCycle:'h23'}).format(new Date(v)):v;
const short=(s:string)=>s.length>18?s.slice(0,8)+'…'+s.slice(-6):s;
const row=(label:string,value:string)=>`<div class="data-row"><span>${e(label)}</span><strong>${e(value)}</strong></div>`;
const details=(id:string,title:string,body:string)=>`<details data-detail="${id}"><summary>${e(title)}</summary><div class="detail-body">${body}</div></details>`;
export const statusTone=(decision:string)=>decision==='WAIT'?'wait':decision==='EXECUTE'?'execute':decision==='BLOCK_DUPLICATE'?'blocked':decision==='FAILED_REVIEW_REQUIRED'?'invalid':'escalate';
const names:Record<string,string>={PAYABLE_EVALUATED:'Payment evaluated',DECISION_WAIT:'Payment held for funding',FUNDING_UPDATE_RECEIVED:'Funding update received',FUNDING_FACTS_EXTRACTED:'Funding change interpreted',EXPECTED_INFLOW_UPDATED:'Expected funding updated',DECISION_ESCALATE:'Timing requires review',FUNDED_SCENARIO_LOADED:'Funding conditions updated',QUOTE_CREATED:'FX quote prepared',DECISION_EXECUTE:'Payment ready for approval',EXECUTION_PREVIEW:'Exact payment presented',APPROVAL_PENDING:'Human approval requested',APPROVAL_APPROVED:'Exact payment approved',APPROVAL_INVALIDATED:'Approval invalidated',PRESENTATION_HUMAN_APPROVAL:'Human approval recorded',PROTECTED_CONTEXT_CHANGED:'Protected FX terms changed',EXECUTION_REFUSED:'Execution refused',RECORDED_PROOF_SHOWN:'Prior Airwallex proof displayed',BLOCK_DUPLICATE:'Duplicate execution blocked',RECORDED_STATE_RESTORED:'Protection restored from persistent state',CONVERSION_SETTLED:'FX conversion settled',TRANSFER_CREATED:'Supplier transfer created'};
const eventName=(name:string)=>names[name]??name.toLowerCase().replace(/_/g,' ').replace(/^./,s=>s.toUpperCase());
export function renderAccountingCheck(v:AccountingCheckView):string{
 const blocked=v.decision==='BLOCK_DUPLICATE';
 return `<section class="panel" id="t0-accounting-check" data-testid="t0-accounting-check" aria-labelledby="t0-accounting-title"><div class="section-heading"><div><p class="eyebrow">Separate accounting check · USD obligation</p><h3 id="t0-accounting-title">Already-paid obligation check</h3></div><span class="badge neutral">Read-only</span></div><p class="muted" data-testid="t0-evidence-mode">${v.evidenceMode==='recorded'?'Recorded T:0 sandbox evidence':'T:0 sandbox · live read-only evidence'}</p>${row('Accounting source','T:0 sandbox')}<div data-testid="t0-obligation-amount">${row('Supplier obligation','USD '+amount(v.amount))}</div>${row('Accounting status',v.accountingStatus.toUpperCase())}<div data-testid="t0-decision" data-decision="${e(v.decision)}">${row('DueGate decision',v.decision)}</div><p>${blocked?'This obligation is already recorded as paid in the accounting system. Further execution is blocked.':'This accounting check does not authorize execution. The obligation requires separate review.'}</p><p><strong>No FX quote, conversion, or transfer requested.</strong></p><p class="tiny muted">Separate accounting check from the EUR demo payable. DueGate makes the decision; accounting status does not prove recipient delivery or an Airwallex transfer.</p>${details('t0-accounting','View accounting evidence',row('Sanitized reference',v.reference)+row('Due date · date only',v.dueDate??'Not provided')+row('Paid date · date only',v.paidDate??'Not provided')+row('Evidence captured',timestamp(v.capturedAt))+row('Source as-of',v.sourceAsOf??'Not provided by this endpoint')+row('DueGate reason',v.reason)+'<p class="tiny muted">Accounting records can lag a nightly export. Capture time is not a guarantee of source freshness. No approval or execution record was created by this check.</p>')}</section>`;
}

const eventSummary=(event:string)=>({DECISION_WAIT:'Confirmed incoming funds are expected before the cutoff.',DECISION_ESCALATE:'The updated funding timing requires human review.',DECISION_EXECUTE:'The deterministic gates passed. Exact human approval is still required.',APPROVAL_PENDING:'Payment terms were presented for explicit approval.',APPROVAL_APPROVED:'A local operator accepted the exact payment context.',APPROVAL_INVALIDATED:'The previous approval can no longer authorize execution.',PRESENTATION_HUMAN_APPROVAL:'Local demo approval recorded against an exact fingerprint.',PROTECTED_CONTEXT_CHANGED:'The synthetic FX quote changed; prior approval no longer matches.',EXECUTION_REFUSED:'No payment submitted. The execution boundary refused the request.',RECORDED_PROOF_SHOWN:'The prior Airwallex execution was displayed. No new money moved.',BLOCK_DUPLICATE:'The existing execution record prevented another submission.',RECORDED_STATE_RESTORED:'The same recorded transfer and duplicate block survived restart.',FUNDING_UPDATE_RECEIVED:'New funding evidence was received for interpretation.',FUNDING_FACTS_EXTRACTED:'The update was interpreted into typed facts, not a payment instruction.',EXPECTED_INFLOW_UPDATED:'The stored funding context was updated and reevaluated.',QUOTE_CREATED:'An FX quote was prepared for the exact payment.',FUNDED_SCENARIO_LOADED:'Application commitments changed; funding was reevaluated.'} as Record<string,string>)[event]??'Supporting evidence retained. Open details for the recorded observation.';
export function renderCase(v:CaseView):string{
 const tone=statusTone(v.decision),invalid=v.approval?.status==='INVALIDATED',title=v.decision==='EXECUTE'?'EXECUTE READY':v.decision;
 const explanation=v.decision==='WAIT'?'Free cash is below the payment requirement. Confirmed incoming funds are expected before the cutoff.':v.decision==='EXECUTE'?(invalid?'Funding and timing pass, but approval no longer matches. Execution stays blocked until new human approval.':'Cash, FX and timing conditions pass. Execution still requires a valid human approval of this exact payment.'):v.decision==='BLOCK_DUPLICATE'?'This payment was already executed and is attached to an existing transfer. Further execution is blocked.':v.decision==='FAILED_REVIEW_REQUIRED'?'Execution requires review. Original identifiers are retained; automatic retry is blocked.':v.reason==='INFLOW_TOO_LATE'?'Expected funding moved beyond the latest safe execution time. Human review is required.':v.reason==='INFLOW_ETA_UNCERTAIN'?'The funding window crosses the cutoff. Arrival in time is not assured.':'The payment cannot safely proceed under the current conditions. Review the decision details.';
 const cutoffOpen=Date.parse(v.clock)<Date.parse(v.cutoff),remaining=Math.max(0,Math.floor((Date.parse(v.cutoff)-Date.parse(v.clock))/60000));
 const restored=v.audit.some(a=>a.event==='RECORDED_STATE_RESTORED'||a.event.includes('RESTART'));
 const newEta=v.facts?.exact?timestamp(v.facts.exact):v.facts?.date?v.facts.date+' · local calendar day':'Timing requires review';
 const fxWithin=v.quote&&Number.isFinite(Number(v.quote.rate))&&Number(v.quote.rate)<=1.5;
 return `<header class="app-header"><a class="brand" href="#payment"><div><h1>DueGate</h1><p>Context-bound payment execution</p></div></a><nav aria-label="Workspace"><a href="#payment">Payment</a><a href="${v.result?'#execution-evidence':'#approval-controls'}">Evidence</a><a href="#audit-history">Audit</a></nav><div class="connection" data-testid="airwallex-status" title="${v.presentationMode?'Live financial execution disabled in demo mode.':''}"><span class="dot ${v.connected&&!v.presentationMode?'connected':''}"></span><span>${e(v.connectionLabel??(v.connected?'Airwallex sandbox: Connected':'Airwallex sandbox: Not checked'))}</span></div></header>
 <main id="payment"><div class="intro" data-testid="demo-mode"><p>PAYMENT WORKSPACE <span>/</span> DG-001</p><span>${v.interpreterProvider==='claude'?'Live interpretation · Claude':v.presentationMode?'Presentation mode · recorded evidence':'Local demo'}</span></div>
 ${v.presentationMode?'<aside class="replay-note"><strong>Recorded Airwallex sandbox proof</strong><span>No-write presentation · synthetic quotes and fixed demo clock. No new payment will be submitted.</span></aside>':''}
 ${v.error?`<div class="error" role="alert"><strong>Request stopped safely</strong><p>${e(v.error)}</p></div>`:''}
 <div class="payable-sheet"><section class="panel hero" aria-labelledby="payment-title"><div><p class="eyebrow">${v.mode==='dry'&&!v.finalProof?'Narrative obligation · not executed':'Single synthetic sandbox payable'}</p><p class="payment-kind">Supplier payment</p><h2 id="payment-title">${e(v.supplier)}</h2><p class="hero-copy">One payable. One exact approval.<br>Execution only while its conditions hold.</p></div><div class="hero-amount" data-testid="payment-amount"><span>EUR</span><strong>${amount(v.amount)}</strong><small>${v.mode==='dry'&&!v.finalProof?'Narrative EUR 10,000 · sandbox execution is EUR 1.00 only':'Sandbox test amount · EUR 1.00 only'}</small></div><div class="hero-bottom"><div><span>Due</span><strong>${e(timestamp(v.due))}</strong></div><div><span>Latest safe execution</span><strong>${e(timestamp(v.cutoff))}</strong></div><span class="badge ${tone}">${e(title)}</span></div></section>
 <section data-testid="duegate-decision" data-decision="${e(v.decision)}" class="decision-panel ${tone}" aria-live="polite"><div class="decision-main"><p class="eyebrow">DueGate decision</p><h2>${v.decision==='BLOCK_DUPLICATE'?'Execution blocked':e(title)}</h2><p class="decision-explanation">${e(explanation)}</p>${details('decision','View decision details',row('Reason code',v.reason)+row('Execution state',v.executionState)+row('Evaluation time',timestamp(v.clock)))}</div><div class="decision-assurance"><strong>${v.presentationMode?'No new money movement':v.financialWrites===0?'No money movement':'Execution evidence retained'}</strong><span>${v.conversionCount} conversion${v.conversionCount===1?'':'s'} ${v.presentationMode?'recorded':'observed'} · ${v.transferCount} transfer${v.transferCount===1?'':'s'} ${v.presentationMode?'recorded':'observed'}</span><small>${v.presentationMode?'New financial writes in this presentation':'Financial writes'}: ${v.financialWrites===null?'review required':v.financialWrites}</small></div></section></div>
 <div class="chapter-heading"><p class="eyebrow">The conditions behind the decision</p><h3>Payment context</h3></div>
 <div class="context-grid" aria-label="Decision context"><section class="panel context"><p class="eyebrow">01 / Cash · USD</p><span class="muted">Free cash</span><strong class="metric">${amount(v.treasury.free)}</strong>${details('cash','Cash breakdown',row(v.presentationMode?'Recorded Airwallex balance':'Airwallex balance',amount(v.treasury.balance))+row('Required reserve',amount(v.treasury.reserve))+row('Application commitments',amount(v.treasury.committed))+row('Required source budget',amount(v.treasury.required))+'<p class="tiny muted">Balance − reserve − commitments. Reserve and commitments are application-owned.</p>')}</section>
 <section data-testid="funding-context" class="panel context"><p class="eyebrow">02 / Expected funding</p><span class="muted">Incoming amount · USD</span><strong class="metric">${amount(v.treasury.inflow)}</strong><p class="context-caption">${e(timestamp(v.treasury.eta))}</p><span class="text-status">${v.facts?'Reported update: '+e(v.facts.classification):'Expected inflow · gate evaluated'}</span></section>
 <section data-testid="fx-context" class="panel context"><p class="eyebrow">03 / FX · USD → EUR</p><span class="muted">USD per EUR</span><strong class="metric">${v.quote?e(v.quote.rate):'Not quoted'}</strong><p class="context-caption">${v.quote?e(v.quoteFreshness)+(v.presentationMode?' · demo clock':''):'No quote needed while waiting'}</p><span class="text-status ${v.quote&&!fxWithin?'danger-text':''}">${v.quote?(fxWithin?'Within rate limit':'Outside rate limit'):'Limit: 1.50 USD per EUR'}</span></section>
 <section data-testid="deadline" class="panel context"><p class="eyebrow">04 / Deadline</p><span class="muted">Execution cutoff</span><strong class="metric deadline">${cutoffOpen?'Open':'Passed'}</strong><p class="context-caption">${Number.isFinite(remaining)?(cutoffOpen?remaining+' min remaining':'Payment requires review'):'Timing unavailable'}${v.presentationMode?' · demo clock':''}</p><span class="text-status">${e(timestamp(v.cutoff))}</span></section></div>

 <div class="context-foot"><div><span>Payment destination</span><strong>${e(v.beneficiary)}</strong></div><div><span>Human approval</span><strong class="${invalid?'danger-text':''}">${invalid?'Invalidated — reapproval required':v.approval?.status??'Not requested'}</strong></div></div>
 ${v.recordedAttached?'<details class="completed-context" data-detail="completed-context"><summary>Review funding and human approval context</summary>':''}<div class="work-grid"><section class="panel update"><div class="section-heading"><div><p class="eyebrow">Evidence</p><h3>Funding update</h3></div><span class="muted tiny">${v.interpreterProvider==='claude'?'Claude interpretation':'Deterministic parser'}</span></div><p class="muted">${v.interpreterProvider==='claude'?'Claude extracts facts only. DueGate makes the deterministic decision.':'Review the new facts before changing the payment context.'}</p><label for="funding-text">Paste a funding or payment update</label><textarea placeholder="Paste a funding or payment update" id="funding-text" rows="3" ${v.mode==='sandbox'?'disabled':''}>The $4,000 customer payment expected Thursday has been delayed until Monday.</textarea><div class="actions"><button data-action="interpret" ${v.mode==='sandbox'?'disabled':''}>Interpret update</button><span class="tiny muted">Facts only. No payment authority.</span></div>
 ${v.facts?`<div class="interpreted"><p class="eyebrow">${v.interpreterProvider==='claude'?'Interpreted by Claude':'Interpreted context'}</p><h4>Interpreted change · ${e(v.facts.classification)}</h4>${row('Amount · USD',amount(v.facts.amount))}<div class="change-flow"><div><span>${v.fundingPreviousEta?'Before':'Stored ETA'}</span><strong>${e(timestamp(v.fundingPreviousEta??v.treasury.eta))}</strong></div><span aria-hidden="true">→</span><div><span>Reported ETA</span><strong>${e(newEta)}</strong></div></div>${v.transition?`<p class="transition">${e(v.transition)}</p>`:'<p class="tiny muted">Apply to evaluate the effect. No decision is inferred from text.</p>'}${v.facts.date?'<p class="tiny muted">No exact arrival time was inferred. Full local calendar day.</p>':''}${details('interpretation','View interpretation details',row('Inflow reference',v.facts.inflow)+row('Amount · USD',amount(v.facts.amount))+row('ETA precision',v.facts.precision)+row('Source hash',v.facts.hash))}</div>`:'<p class="empty-state">The interpreted change will appear here.</p>'}<button class="primary" data-action="apply" ${v.canApply?'':'disabled'}>Apply update & reevaluate</button></section>
 <section class="panel approval-panel" id="approval-controls"><div class="section-heading"><div><p class="eyebrow">Human control</p><h3>Authorize this exact payment</h3></div></div><p class="muted">Approval is bound to the payment, quote, funding and cutoff shown here.</p>
 ${v.quote?`<div class="quote-summary"><span>FX quote ${v.presentationMode?'· synthetic demo':''}</span><strong>USD ${amount(v.quote.sourceAmount)} <span>→</span> EUR ${amount(v.quote.targetAmount)}</strong>${row('Rate · USD per EUR',v.quote.rate)}${row('Fresh until',timestamp(v.quote.expires))}${row('Quote freshness',v.quoteFreshness+(v.presentationMode?' · demo clock':''))}</div>`:'<div class="empty-state">Make funding conditions valid to prepare an exact quote. Loading a preview submits no payment.</div>'}
 ${v.quote&&(v.quoteFreshness!=='FRESH'||!fxWithin)?`<div class="quote-refusal" role="status"><strong>${v.quoteFreshness!=='FRESH'?'Quote is not fresh':'Quote exceeds the rate limit'}</strong><p>This quote cannot support execution. Prepare acceptable terms and request new approval.</p></div>`:''}
 ${invalid?`<div data-testid="approval-invalidated" class="invalidation" role="alert"><p class="eyebrow">APPROVAL INVALIDATED</p><h4>Execution blocked</h4><p>${e(v.approvalReason??'Approval no longer matches the current execution context.')}</p><p><strong>Action required:</strong> new context and new human approval.</p><small>Protected terms changed. The previously approved terms cannot authorize execution.</small></div>`:''}
 <div class="approval-state" data-testid="human-approval-state"><span class="badge ${invalid?'invalid':'neutral'}">${v.approval?.status==='PENDING'?'APPROVAL REQUIRED':v.approval?.status??'NO APPROVAL'}</span>${v.approval?.approved_at?row('Approved by',v.approval.actor_display_label??'Local demo operator · historical record')+row('Approval timestamp',timestamp(v.approval.approved_at)):'<p class="muted">Approval actor: Human operator · local demo</p>'}${v.approval?row('Approval fingerprint',short(v.approval.execution_fingerprint)):''}<p class="tiny muted">Any protected change invalidates this approval. Local label only; no authenticated identity is claimed.</p></div>
 <button class="primary" data-action="approve" ${v.canApprove?'':'disabled'}>Approve exact payment</button>
 ${details('approval','View payment & approval details',row('Supplier',v.supplier)+row('Beneficiary',v.beneficiary)+row('Target amount · EUR',v.amount)+row('Required reserve · USD',v.treasury.reserve)+row('Free cash · USD',v.treasury.free)+(v.preview?row('Reserve preserved · USD',v.preview.reserveRemaining):'')+row('Latest safe execution',timestamp(v.cutoff))+row('FX policy',v.quoteLimit??'Maximum 1.50 USD per EUR')+(v.approval?row('Full fingerprint',v.approval.execution_fingerprint):'')+(v.quote?row('Quote ID',v.quote.id):''))}
 <div class="demo-controls"><p class="eyebrow">${v.presentationMode?'No-write demo controls':'Preview controls'}</p><div class="button-stack"><button data-action="funded">${v.mode==='dry'?'Load funded scenario':'Refresh funded preview'}</button><button data-action="refresh-context" ${v.executionState==='MISSING'?'':'disabled'}>Recheck cash and timing</button><button data-action="invalidate" ${v.approval?.status==='APPROVED'&&v.executionState==='MISSING'?'':'disabled'}>Change protected quote context</button></div></div>
 ${v.presentationMode?'<button class="primary" data-action="show-recorded" '+(v.approval?.status==='APPROVED'&&!v.recordedAttached?'':'disabled')+'>Show recorded proof — no execution</button><button data-action="execute" '+(v.recordedAttached||invalid?'':'disabled')+'>Test refusal — no execution</button>':''}
 <button class="execute-button" data-action="execute" ${v.canExecute?'':'disabled'}>Execute sandbox payment <span>EUR 1.00</span></button>${v.financialWritesEnabled===false?'<p class="tiny muted">Financial writes disabled. This view cannot submit a payment.</p>':''}</section></div>${v.recordedAttached?'</details>':''}
 ${v.result?`<section class="panel result" id="execution-evidence" data-testid="execution-evidence"><div class="section-heading"><div><p class="eyebrow">Execution evidence</p><h3>${v.presentationMode?'Recorded Airwallex sandbox proof':'Airwallex sandbox execution result'}</h3></div><span class="badge neutral">EUR 1.00 · sandbox</span></div>${v.presentationMode?'<p class="muted">Already executed EUR 1.00. Historical approval consumed. This did not happen again.</p>':''}<div class="execution-flow"><div><span>USD sold</span><strong>${amount((Number(v.result.usdBefore)-Number(v.result.usdAfter)).toFixed(2))}</strong></div><span class="flow-arrow" aria-hidden="true">→</span><div><span>FX conversion</span><strong>${e(v.result.conversionStatus)}</strong><small>EUR 1.00 received</small></div><span class="flow-arrow" aria-hidden="true">→</span><div><span>Supplier transfer · EUR 1.00</span><strong>${e(v.result.transferStatus)}</strong><small>${e(v.recordedFunding??'Funding status not shown')}${v.recordedFee?' · fee '+e(v.recordedFee):''}</small></div></div><p class="tiny muted">Recipient delivery not yet proven. Provider status is shown without inferring completion.</p>${details('identifiers','View execution identifiers & balances',row('Conversion ID',short(v.result.conversionId))+row('Transfer ID',short(v.result.transferId))+row('USD before → after',amount(v.result.usdBefore)+' → '+amount(v.result.usdAfter))+row('EUR before → after',amount(v.result.eurBefore)+' → '+amount(v.result.eurAfter))+row('Payable ID',v.payableId)+(v.preview?row('Logical execution key',v.preview.key):''))}${!v.presentationMode?'<button data-action="refresh-status">Read transfer status</button>':''}</section>`:''}
 ${v.decision==='BLOCK_DUPLICATE'?`<section class="duplicate-panel" data-testid="duplicate-blocked"><div class="shield" aria-hidden="true">✓</div><div><h3>Duplicate protection is active</h3><p>${e(explanation)}</p><p class="muted">${v.presentationMode?'No new quote · No new conversion · No new transfer':'Further execution is blocked by the persisted record.'}</p>${restored?'<strong class="restored">Protection restored from persistent state · same transfer ID</strong>':''}</div><span class="badge blocked">BLOCK_DUPLICATE</span></section>`:''}
 ${v.accountingCheck?renderAccountingCheck(v.accountingCheck):''}
 <section class="panel timeline" id="audit-history" data-testid="audit-timeline"><div class="section-heading"><div><p class="eyebrow">Decision history</p><h3>Audit timeline</h3></div><a class="button audit-download" href="/api/audit" download="duegate-audit.json">Export audit JSON</a></div><p class="muted tiny">${v.presentationMode?'Current demo events use a fixed clock; capture events have real timestamps. Prior execution is separate recorded evidence.':'Persisted event history. Provider statuses do not imply delivery.'}</p><ol>${v.audit.map((a,i)=>`<li id="audit-event-${i}" data-testid="audit-event" data-event="${e(a.event)}"><time>${e(timestamp(a.at))}</time><div><strong>${e(eventName(a.event))}</strong><p class="event-summary">${e(eventSummary(a.event))}</p>${details('audit-'+i,'View audit evidence','<code>'+e(a.event)+'</code><p>'+e(a.detail)+'</p>')}</div></li>`).join('')||'<li>No events yet.</li>'}</ol></section>
 <footer><span>Deterministic rules. Human approval. Persistent protection.</span><span>DueGate · local sandbox demo</span></footer></main>`;
}
export function renderConfirmation(v:CaseView,action:'approve'|'execute'):string{
 if(!v.quote||!v.approval)return '';
 return `<div class="confirmation-backdrop"><section role="dialog" aria-modal="true" aria-labelledby="confirmation-title" aria-describedby="confirmation-warning" class="confirmation-card" tabindex="-1"><div class="modal-head"><p class="eyebrow">Human approval</p><h2 id="confirmation-title">Authorize this exact payment</h2><p>${e(v.supplier)} <span class="muted">· ${e(v.beneficiary)}</span></p><div class="modal-amount">EUR ${amount(v.amount)} <small>from USD ${amount(v.quote.sourceAmount)}</small></div></div><div class="modal-body"><p class="confirmation-effect">${action==='approve'?'This action records approval only. It does not submit a conversion or transfer.':v.presentationMode?'No financial write is available in this presentation.':'Confirmation authorizes the controller to convert the quoted source amount and submit one EUR 1.00 sandbox transfer, only if all guards still pass.'}</p>${v.presentationMode?'<p class="replay-note">NO-WRITE PRESENTATION · synthetic quote at demo clock. Records local approval only.</p>':''}<div class="confirmation-grid">${row('Supplier',v.supplier)}${row('Beneficiary',v.beneficiary)}${row('Payment',v.target+' '+v.amount)}${row('FX source',v.source+' '+v.quote.sourceAmount)}${row('Exchange rate · USD/EUR',v.quote.rate)}${row('Quote expiry',timestamp(v.quote.expires))}${row('Freshness',v.quoteFreshness+(v.presentationMode?' at demo clock':''))}${row('Latest safe execution',timestamp(v.cutoff))}${row('Required reserve · USD',v.treasury.reserve)}${row('Free cash · USD',v.treasury.free)}${row('Approval fingerprint',short(v.approval.execution_fingerprint))}${row('Quote',v.quote.id)}</div><p class="approval-warning" id="confirmation-warning">Protected context changes invalidate this approval. A new quote or changed payment/funding context requires new human approval.</p><p class="tiny muted">Approval actor: Human operator · local demo. Local label only; no authenticated identity is claimed.</p></div><div class="modal-actions"><button data-action="cancel-confirmation">Cancel</button><button class="primary" data-action="confirm-${action}">${action==='approve'?'Approve exact payment':'Confirm & authorize EUR 1.00'}</button></div></section></div>`;
}
