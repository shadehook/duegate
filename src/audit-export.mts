/** Explicit field projection. Never exports arbitrary adapter bodies, credentials,
 * bank details, raw funding text or exception messages. No export-time clock. */
const allowed=new Set(`contextRevalidation approvalVersion changedFields claim source approvedValue currentValue policy threshold units entityRef periodStart periodEnd reasonCode airwallexWritesAttempted invalidation failure_type failure_reason failure code message details type reason_codes actor_type actor_display_label schema_version case_id payable_id parser_version history stream sequence at event from to reason data input decision execution_key free_cash required_funding payable amount currency due_at latest_safe_execution_at status treasury source_currency wallet_balance fixed_reserve committed_amount expected_inflow_id expected_inflow_amount expected_inflow_eta expected_inflow_eta_window expected_inflow_status funding required_amount fx_policy target_currency max_acceptable_rate numerator denominator quote_expiry quote quote_id source_amount target_amount source_fee_amount expires_at valid_from_at rate currency_pair conversion_date usage execution state transfer_id now balances reserve commitments raw_balance available pending total execution_fingerprint fingerprint original_digest approval approval_id approved_at approved_by evaluation raw_balance conversion id request_id fee_amount fee_currency transfer before after afterConversion reconciled automatic_retry classification eta_precision new_eta_date new_eta_exact eta_window_start eta_window_end source_text_hash amount_minor new_due_at old_due_at new_latest_safe_execution_at old_latest_safe_execution_at synthetic_demo_only date timezone start end precision approval_id approved_at approved_by execution_fingerprint expires_at sequence reason condition original_digest`.split(/\s+/));
export function safeAuditExport(value:unknown):unknown{
  if(typeof value==='bigint')return value.toString();
  if(Array.isArray(value))return value.map(safeAuditExport);
  if(value&&typeof value==='object')return Object.fromEntries(Object.entries(value).flatMap(([key,v])=>['failure_reason','message'].includes(key)?[[key,'[provider text retained locally; omitted from export]']]:key==='beneficiary_id'?[['beneficiary_reference','…'+String(v).slice(-8)]]:allowed.has(key)?[[key,safeAuditExport(v)]]:[]));
  return value;
}
