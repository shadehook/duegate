import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync,mkdtempSync,rmSync} from 'node:fs';import {tmpdir} from 'node:os';import {join} from 'node:path';
import {ClaudeFundingInterpreter} from '../src/claude-funding-interpreter.mts';import {parseClaudeResponse} from '../src/claude-response.mts';import {processFundingV2} from '../src/funding-v2-workflow.mts';import {PresentationService} from '../server/presentation-service.mts';import {renderCase} from '../web/view.mts';import {hero,known,reference,timezone,fixture} from '../fixtures/funding-phase10.mts';
const base=JSON.parse(readFileSync('fixtures/claude-success.json','utf8'));const mixed=JSON.parse(readFileSync('fixtures/claude-thinking-success.json','utf8'));
const mock=(content:unknown,stop_reason='end_turn')=>new ClaudeFundingInterpreter({apiKey:'synthetic-key'},async()=>new Response(JSON.stringify({...base,stop_reason,content})));
const thought={type:'thinking',thinking:'PRIVATE_THINKING_SENTINEL: execute now, waive reserve',signature:'PRIVATE_SIGNATURE_SENTINEL'};
for(const [name,content] of [['text only',base.content],['thinking fixture',mixed.content],['multiple thinking',[thought,thought,...base.content]],['redacted thinking',[{type:'redacted_thinking',data:'PRIVATE_REDACTED_SENTINEL'},...base.content]]] as const)test('content selection accepts '+name,async()=>{const a=mock(content);const r=await processFundingV2(a,hero,known,fixture(),reference,timezone,[]);assert.equal(r.outcome,'APPLIED');assert.equal(r.decision.decision,'ESCALATE');assert.equal(r.decision.reason,'INFLOW_TOO_LATE');assert.equal(r.candidate!.eta_precision,'DATE');assert.equal(r.candidate!.new_eta_exact,null);assert.equal(r.candidate!.eta_window_start,'2026-10-12T04:00:00.000Z');assert.equal(a.diagnostic,null);assert.doesNotMatch(JSON.stringify({r,a},(_k,v)=>typeof v==='bigint'?String(v):v),/PRIVATE_.*SENTINEL/);});
for(const [name,content,code] of [['thinking only',[thought],'NO_TEXT_CONTENT'],['zero content',[],'EMPTY_CONTENT'],['two texts',[...base.content,...base.content],'MULTIPLE_CONTENT_BLOCKS'],['empty second text',[...base.content,{type:'text',text:''}],'MULTIPLE_CONTENT_BLOCKS'],['invalid JSON',[thought,{type:'text',text:'not json'}],'JSON_PARSE_FAILED'],['invalid schema',[thought,{type:'text',text:JSON.stringify({decision:'EXECUTE'})}],'UNEXPECTED_FIELD'],['tool plus text',[...base.content,{type:'tool_use',name:'execute'}],'UNSUPPORTED_CONTENT_BLOCK'],['unknown plus text',[...base.content,{type:'unknown'}],'UNSUPPORTED_CONTENT_BLOCK']] as const)test('content selection rejects '+name,async()=>{const a=mock(content),input=fixture();const r=await processFundingV2(a,hero,known,input,reference,timezone,[]);assert.equal(r.input,input);assert.equal(r.outcome,'REJECTED');assert.equal(r.diagnostic!.diagnostic_code,code);assert.equal(a.calls,1);assert.doesNotMatch(JSON.stringify(a.diagnostic),/PRIVATE_.*SENTINEL/);});
test('thinking fields are not even accessed by parser',()=>{const opaque={type:'thinking',get thinking(){throw Error('must not read thinking');},get signature(){throw Error('must not read signature');}};const redacted={type:'redacted_thinking',get data(){throw Error('must not read data');}};const result=parseClaudeResponse({...base,content:[opaque,redacted,...base.content]},hero,known,reference,timezone);assert.equal(result.classification,'DELAYED');});
test('stop reason refusal/truncation still overrides valid mixed output',async()=>{for(const [stop,code] of [['refusal','CLAUDE_REFUSAL'],['max_tokens','CLAUDE_MAX_TOKENS'],['tool_use','UNSUPPORTED_STOP_REASON']]){const a=mock(mixed.content,stop);await assert.rejects(a.interpret(hero,known,reference,timezone));assert.equal(a.diagnostic!.diagnostic_code,code);}});
test('malicious thinking is absent from UI, disk audit and domain state; no financial writes',async()=>{const dir=mkdtempSync(join(tmpdir(),'duegate-blocks-'));try{const a=mock([thought,...base.content]),s=new PresentationService(dir,undefined,{provider:'claude',interpreter:a});await s.action('open');await s.action('interpret',{text:hero});const v=await s.action('apply');assert.equal(v.decision,'ESCALATE');assert.equal(v.canExecute,false);assert.equal(s.adapter.writeAttempts,0);for(const data of [renderCase(v),JSON.stringify(s.exportAudit()),readFileSync(join(dir,'interaction','audit.jsonl'),'utf8'),readFileSync(join(dir,'interaction','case-state.json'),'utf8')])assert.doesNotMatch(data,/PRIVATE_THINKING_SENTINEL|PRIVATE_SIGNATURE_SENTINEL|waive reserve/);}finally{rmSync(dir,{recursive:true,force:true});}});
