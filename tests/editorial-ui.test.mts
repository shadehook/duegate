import test from 'node:test';import assert from 'node:assert/strict';import {mkdtempSync,rmSync} from 'node:fs';import {tmpdir} from 'node:os';import {join} from 'node:path';import {PresentationService} from '../server/presentation-service.mts';import {renderCase,renderConfirmation} from '../web/view.mts';
async function fixture(fn:(s:PresentationService)=>Promise<void>){const dir=mkdtempSync(join(tmpdir(),'duegate-editorial-'));try{await fn(new PresentationService(dir));}finally{rmSync(dir,{recursive:true});}}
test('editorial: decision belongs to the central payable before context',()=>fixture(async s=>{const h=renderCase(await s.action('open'));assert.ok(h.indexOf('payable-sheet')<h.indexOf('decision-panel'));assert.ok(h.indexOf('decision-panel')<h.indexOf('context-grid'));assert.match(h,/One payable. One exact approval/);assert.match(h,/Payment destination/);assert.match(h,/Human approval/);}));
test('editorial: stale and out-of-limit quotes have explicit visible refusal',()=>fixture(async s=>{const v=await s.action('funded');assert.match(renderCase({...v,quoteFreshness:'EXPIRED',canExecute:false}),/Quote is not fresh/);assert.match(renderCase({...v,quote:{...v.quote!,rate:'1.60'},canExecute:false}),/Quote exceeds the rate limit/);assert.match(renderCase({...v,quoteFreshness:'INVALID'}),/This quote cannot support execution/);assert.equal(s.adapter.writeAttempts,0);}));
test('editorial: approval and execution confirmations explain different effects',()=>fixture(async s=>{const v=await s.action('funded');assert.match(renderConfirmation(v,'approve'),/records approval only/);assert.match(renderConfirmation(v,'execute'),/No financial write is available/);assert.match(renderConfirmation({...v,presentationMode:false},'execute'),/only if all guards still pass/);}));
test('editorial: evidence narrative is readable without opening internal details',()=>fixture(async s=>{const h=renderCase(await s.action('open'));assert.match(h,/class="event-summary"/);assert.match(h,/Confirmed incoming funds are expected before the cutoff/);assert.match(h,/View audit evidence/);assert.match(h,/Export audit JSON/);}));
test('editorial: blocked payment keeps machine status and historical truth',()=>fixture(async s=>{const v=await s.action('funded');await s.action('approve',{fingerprint:v.approval!.execution_fingerprint});const h=renderCase(await s.action('show-recorded'));assert.match(h,/Execution blocked/);assert.match(h,/BLOCK_DUPLICATE/);assert.match(h,/This did not happen again/);assert.match(h,/Recipient delivery not yet proven/);assert.equal(s.adapter.writeAttempts,0);}));
