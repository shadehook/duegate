import test from 'node:test';import assert from 'node:assert/strict';import {mkdtempSync,rmSync,readFileSync} from 'node:fs';import {tmpdir} from 'node:os';import {join,resolve,sep} from 'node:path';import {PresentationService} from '../server/presentation-service.mts';import {renderCase,renderConfirmation} from '../web/view.mts';
async function fixture(fn:(s:PresentationService,dir:string)=>Promise<void>){const dir=mkdtempSync(join(tmpdir(),'duegate-ui-proof-'));try{await fn(new PresentationService(dir),dir);}finally{assert.ok(resolve(dir).startsWith(resolve(tmpdir())+sep+'duegate-ui-proof-'));rmSync(dir,{recursive:true});}}
async function approve(s:PresentationService){let v=await s.action('funded');return s.action('approve',{fingerprint:v.approval!.execution_fingerprint});}
test('presentation confirmation shows exact payment and protected context',()=>fixture(async s=>{const v=await s.action('funded'),html=renderConfirmation(v,'approve');for(const value of [v.supplier,v.beneficiary,v.amount,v.quote!.rate,v.quote!.id,v.treasury.reserve,v.treasury.free,'Human approval','Cancel','Approve exact payment','Protected context changes','NO-WRITE PRESENTATION'])assert.ok(html.includes(value),value);assert.ok(html.includes(v.approval!.execution_fingerprint.slice(0,8)));}));
test('presentation actor HUMAN, label, fingerprint and timestamp persist',()=>fixture(async(s,dir)=>{const v=await approve(s);assert.equal(v.approval!.actor_type,'HUMAN');assert.match(v.approval!.actor_display_label!,/Human operator/);assert.ok(v.approval!.approved_at);const next=new PresentationService(dir);assert.deepEqual(next.view().approval,v.approval);const audit=JSON.stringify(next.exportAudit());assert.ok(audit.includes(v.approval!.execution_fingerprint));assert.ok(audit.includes('PRESENTATION_HUMAN_APPROVAL'));assert.match(renderCase(v),/Approved by/);}));
test('protected quote mutation visibly invalidates and refuses execution',()=>fixture(async s=>{await approve(s);let v=await s.action('invalidate');assert.equal(v.approval!.status,'INVALIDATED');assert.equal(v.canExecute,false);assert.match(renderCase(v),/Approval invalidated: FX quote changed/);v=await s.action('execute');assert.match(v.error!,/Execution refused/);assert.equal(s.adapter.writeAttempts,0);v=await approve(s);assert.equal(v.approval!.status,'APPROVED');}));
test('presentation complete sequence shows prior result, duplicates and restart without writes',()=>fixture(async(s,dir)=>{let v=await s.action('open');assert.equal(v.decision,'WAIT');await s.action('interpret',{text:v.fundingExample});v=await s.action('apply');assert.equal(v.decision,'ESCALATE');await approve(s);await s.action('invalidate');await s.action('execute');await approve(s);v=await s.action('show-recorded');assert.equal(v.decision,'BLOCK_DUPLICATE');assert.equal(v.conversionCount,1);assert.equal(v.transferCount,1);assert.equal(v.financialWrites,0);assert.equal(v.result!.transferId,'recorded-transfer');await s.action('execute');const next=new PresentationService(dir);v=await next.action('open');assert.equal(v.decision,'BLOCK_DUPLICATE');assert.match(JSON.stringify(next.exportAudit()),/RECORDED_STATE_RESTORED/);assert.equal((await next.action('execute')).decision,'BLOCK_DUPLICATE');assert.equal(next.adapter.writeAttempts,0);assert.equal(s.adapter.writeAttempts,0);}));
test('recorded proof cannot be shown without approval or after invalidation',()=>fixture(async s=>{await assert.rejects(s.action('show-recorded'));await approve(s);await s.action('invalidate');await assert.rejects(s.action('show-recorded'));}));
test('connection badge distinguishes recorded, live and unchecked states',()=>fixture(async s=>{const v=await s.action('open');assert.match(renderCase(v),/Airwallex sandbox proof · Recorded/);assert.doesNotMatch(renderCase(v),/dot connected/);assert.match(renderCase({...v,presentationMode:false,connected:true,connectionLabel:'Airwallex sandbox: Connected'}),/Airwallex sandbox: Connected/);assert.match(renderCase({...v,presentationMode:false,connectionLabel:'Airwallex proof: Recorded · live connection not checked'}),/live connection not checked/);}));
test('presentation renders original funding and fee as recorded evidence',()=>fixture(async s=>{await approve(s);const v=await s.action('show-recorded'),html=renderCase(v);for(const label of ['Recorded Airwallex sandbox proof','FUNDED','EUR 0.00','Already executed EUR 1.00','This did not happen again','BLOCK_DUPLICATE'])assert.ok(html.includes(label),label);assert.equal(v.canExecute,false);}));
test('presentation never instantiates financial adapter or exposes financial paths',()=>{const source=readFileSync('server/presentation-service.mts','utf8');assert.doesNotMatch(source,/AirwallexSandbox|fetch\(|\.env|continuePrepared|\.prepare\(/);assert.match(readFileSync('server/demo-server.mts','utf8'),/PRESENTATION_CANNOT_ENABLE_WRITES/);});
test('confirmation uses stable page dialog rather than native window confirm',()=>{const app=readFileSync('web/app.mts','utf8');assert.doesNotMatch(app,/window\.confirm/);assert.match(app,/confirm-approve/);assert.match(app,/cancel-confirmation/);assert.match(app,/saved\.fingerprint!==view\.approval/);});

test('recording copy and stable selectors retain the deterministic sequence',()=>fixture(async s=>{let v=await s.action('open'),html=renderCase(v);assert.equal(v.decision,'WAIT');assert.match(html,/Presentation mode · recorded evidence/);assert.match(html,/Live financial execution disabled in demo mode/);assert.doesNotMatch(html,/Local demo · no live LLM/);assert.match(renderCase({...v,interpreterProvider:'claude'}),/Live interpretation · Claude/);for(const id of ['payment-amount','duegate-decision','funding-context','fx-context','deadline','human-approval-state','audit-timeline'])assert.ok(html.includes('data-testid="'+id+'"'));assert.match(html,/data-event="DECISION_WAIT"/);await s.action('interpret',{text:v.fundingExample});v=await s.action('apply');assert.equal(v.decision,'ESCALATE');assert.match(renderCase(v),/data-event="DECISION_ESCALATE"/);await approve(s);v=await s.action('invalidate');assert.match(renderCase(v),/data-testid="approval-invalidated"/);await approve(s);v=await s.action('show-recorded');html=renderCase(v);assert.match(html,/This payment was already executed and is attached to an existing transfer. Further execution is blocked./);assert.ok(html.includes('data-testid="execution-evidence"'));assert.ok(html.includes('data-testid="duplicate-blocked"'));assert.equal(s.adapter.writeAttempts,0);}));
