import test from 'node:test';import assert from 'node:assert/strict';import {mkdtempSync,rmSync,readFileSync} from 'node:fs';import {tmpdir} from 'node:os';import {join} from 'node:path';import {PresentationService} from '../server/presentation-service.mts';import {renderCase,renderConfirmation,statusTone} from '../web/view.mts';
async function fixture(fn:(s:PresentationService,dir:string)=>Promise<void>){const dir=mkdtempSync(join(tmpdir(),'duegate-redesign-'));try{await fn(new PresentationService(dir),dir);}finally{rmSync(dir,{recursive:true});}}
test('redesign: payment hero distinguishes narrative and EUR1 proof',()=>fixture(async s=>{const v=await s.action('open');assert.match(renderCase(v),/Supplier payment/);assert.match(renderCase(v),/Sandbox test amount · EUR 1.00 only/);assert.match(renderCase({...v,finalProof:false,mode:'dry',amount:'10000.00'}),/Narrative EUR 10,000 · sandbox execution is EUR 1.00 only/);}));
test('redesign: four context cards and expandable financial inputs',()=>fixture(async s=>{const html=renderCase(await s.action('open'));for(const label of ['Cash · USD','Expected funding','FX · USD','Deadline','Available after reserve and commitments','Recorded Airwallex balance','Application commitments','Required reserve'])assert.ok(html.includes(label));assert.match(html,/<details data-detail="cash">/);}));
test('redesign: all decision states have restrained semantic tones',()=>{assert.deepEqual(['WAIT','EXECUTE','ESCALATE','BLOCK_DUPLICATE','FAILED_REVIEW_REQUIRED'].map(statusTone),['wait','execute','escalate','blocked','invalid']);const css=readFileSync('web/styles.css','utf8');assert.doesNotMatch(css,/gradient\(/);assert.match(css,/#F7F8FA/);assert.match(css,/color-scheme:light/);} );
test('redesign: execute ready never implies automatic approval',()=>fixture(async s=>{const v=await s.action('funded');const html=renderCase(v);assert.match(html,/EXECUTE READY/);assert.match(html,/still requires a valid human approval/);assert.match(renderConfirmation(v,'approve'),/aria-describedby="confirmation-warning"/);}));
test('redesign: interpreted changes preserve exact versus date uncertainty',()=>fixture(async s=>{let v=await s.action('open');const old=v.treasury.eta;v=await s.action('interpret',{text:v.fundingExample});assert.match(renderCase({...v,fundingPreviousEta:old}),/>Before</);assert.match(renderCase(v),/View interpretation details/);assert.match(renderCase(v),/Reported ETA/);}));
test('redesign: invalidation prominently blocks rather than only logging',()=>fixture(async s=>{let v=await s.action('funded');await s.action('approve',{fingerprint:v.approval!.execution_fingerprint});v=await s.action('invalidate');const h=renderCase(v);assert.match(h,/class="invalidation" role="alert"/);assert.match(h,/Execution blocked/);assert.match(h,/new context and new human approval/);assert.match(h,/data-action="execute" disabled/);}));
test('redesign: recorded flow, fee, delivery disclaimer and identifiers',()=>fixture(async s=>{let v=await s.action('funded');await s.action('approve',{fingerprint:v.approval!.execution_fingerprint});v=await s.action('show-recorded');const h=renderCase(v);for(const label of ['Recorded Airwallex sandbox proof','SETTLED','PROCESSING','FUNDED','EUR 0.00','Recipient delivery not yet proven','View execution identifiers &amp; balances'])assert.ok(h.includes(label),label);assert.equal(s.adapter.writeAttempts,0);}));
test('redesign: restart and duplicate remain visible with no extra provider calls',()=>fixture(async(s,dir)=>{let v=await s.action('funded');await s.action('approve',{fingerprint:v.approval!.execution_fingerprint});await s.action('show-recorded');const next=new PresentationService(dir);v=await next.action('open');const h=renderCase(v);assert.match(h,/Protection restored from persistent state/);assert.match(h,/No new quote · No new conversion · No new transfer/);assert.match(h,/recorded-transfer/);assert.equal(next.adapter.writeAttempts,0);}));
test('redesign: readable audit labels retain raw evidence only in disclosures',()=>fixture(async s=>{const h=renderCase(await s.action('open'));assert.match(h,/Payment evaluated/);assert.match(h,/View audit evidence/);assert.match(h,/Export audit JSON/);assert.match(h,/<details data-detail="decision">/);assert.match(h,/<code>PAYABLE_EVALUATED<\/code>/);}));
test('redesign: keyboard modal cancellation and trap are wired without native dialogs',()=>{const app=readFileSync('web/app.mts','utf8');for(const fragment of ["event.key==='Escape'","event.key!=='Tab'",'event.shiftKey','inert=Boolean(modal)','returnFocusAction','closeConfirmation'])assert.ok(app.includes(fragment));assert.doesNotMatch(app,/window\.confirm/);});
