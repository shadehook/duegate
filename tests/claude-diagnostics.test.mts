import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync,mkdtempSync,rmSync} from 'node:fs';import {join} from 'node:path';import {tmpdir} from 'node:os';
import {ClaudeFundingInterpreter} from '../src/claude-funding-interpreter.mts';
import {diagnosticCatalog,safeDiagnostic,FundingDiagnosticError} from '../src/funding-diagnostics.mts';
import {parseClaudeResponse} from '../src/claude-response.mts';
import {applyFundingV2,wireCandidate,emptyCandidate} from '../src/funding-v2.mts';
import {processFundingV2} from '../src/funding-v2-workflow.mts';
import {PresentationService} from '../server/presentation-service.mts';
import {hero,known,reference,timezone,fixture} from '../fixtures/funding-phase10.mts';
const payload=JSON.parse(readFileSync('fixtures/claude-success.json','utf8'));
const candidate=()=>JSON.parse(payload.content[0].text);
const envelope=(c:unknown)=>({...payload,content:[{type:'text',text:JSON.stringify(c)}]});
const mock=(body:unknown)=>new ClaudeFundingInterpreter({apiKey:'synthetic-test-key'},async()=>new Response(JSON.stringify(body)));
async function rejected(body:unknown,code:string,raw=hero){const a=mock(body),input=fixture();const r=await processFundingV2(a,raw,known,input,reference,timezone,[]);assert.equal(r.outcome,'REJECTED');assert.equal(r.input,input);assert.equal(r.review_required,true);assert.equal(a.diagnostic!.diagnostic_code,code);assert.equal(a.diagnostic!.status,200);assert.equal(a.calls,1);assert.equal(r.diagnostic!.diagnostic_code,code);assert.ok(a.diagnostic!.field_path);assert.ok(a.diagnostic!.parser_stage);return a;}

test('exact successful wire fixture normalizes then reaches deterministic ESCALATE offline',async()=>{const a=mock(payload);const r=await processFundingV2(a,hero,known,fixture(),reference,timezone,[]);assert.equal(a.diagnostic,null);assert.equal(r.diagnostic,null);assert.equal(r.outcome,'APPLIED');assert.equal(r.decision.decision,'ESCALATE');assert.equal(r.decision.reason,'INFLOW_TOO_LATE');assert.equal(r.candidate!.new_eta_exact,null);assert.equal(r.candidate!.eta_window_start,'2026-10-12T04:00:00.000Z');assert.equal(r.candidate!.eta_window_end,'2026-10-13T04:00:00.000Z');});
const contentCases:[string,unknown][]=[['INVALID_RESPONSE_ENVELOPE',null],['CLAUDE_REFUSAL',{...payload,stop_reason:'refusal'}],['CLAUDE_MAX_TOKENS',{...payload,stop_reason:'max_tokens'}],['UNSUPPORTED_STOP_REASON',{...payload,stop_reason:'secret-stop-value'}],['NO_TEXT_CONTENT',{...payload,content:null}],['EMPTY_CONTENT',{...payload,content:[]}],['MULTIPLE_CONTENT_BLOCKS',{...payload,content:[...payload.content,...payload.content]}],['UNSUPPORTED_CONTENT_BLOCK',{...payload,content:[{type:'tool_use',name:'execute'}]}],['NO_TEXT_CONTENT',{...payload,content:[{type:'text'}]}],['EMPTY_CONTENT',{...payload,content:[{type:'text',text:'   '}]}],['JSON_PARSE_FAILED',{...payload,content:[{type:'text',text:'private not json'}]}],['SCHEMA_VALIDATION_FAILED',envelope([])]];
contentCases.forEach(([code,value],i)=>test('envelope rejection '+code+' '+i,async()=>{await rejected(value,code);}));
const patches:[string,object,string?][]=[
 ['UNSUPPORTED_EVENT_TYPE',{classification:'EXECUTE'}],['UNSUPPORTED_CURRENCY',{currency:'GBP'}],['INVALID_AMOUNT',{amount_minor:1.25}],['INVALID_AMOUNT',{amount_minor:'400000'}],['INVALID_AMOUNT',{amount_minor:-1}],['INVALID_AMOUNT',{amount_minor:Number.MAX_SAFE_INTEGER+1}],['INVALID_INFLOW_ID',{expected_inflow_id:'wrong'}],['INVALID_AMBIGUITIES',{ambiguities:['private-reason']}],['INVALID_TEMPORAL_TYPE',{eta_precision:'EXACT'}],['INVALID_TEMPORAL_TYPE',{new_eta_date:42}],['UNKNOWN_INFLOW',{expected_inflow_id:'INFLOW-OTHER'}],['CURRENCY_MISMATCH',{currency:'EUR'}],['CURRENCY_MISMATCH',{currency:null}],['UNKNOWN_HAS_ETA',{eta_precision:'UNKNOWN'}],['INVALID_EXACT',{eta_precision:'EXACT_TIMESTAMP',new_eta_exact:'2026-10-12T13:00:00Z',new_eta_date:null}],['INVENTED_EXACT_TIME',{eta_precision:'EXACT_TIMESTAMP',new_eta_exact:'2026-10-12T13:00:00.000Z',new_eta_date:null}],['INVALID_DATE_PRECISION',{new_eta_date:null}],['INVALID_DAY_WINDOW',{eta_window_start:'2026-10-12T05:00:00.000Z'}],['INVALID_WINDOW_PRECISION',{eta_precision:'TIME_WINDOW'}],['INVALID_WINDOW',{eta_precision:'TIME_WINDOW',new_eta_date:null,eta_window_start:'2026-10-13T04:00:00.000Z',eta_window_end:'2026-10-12T04:00:00.000Z'}],['INVALID_DATE',{new_eta_date:'2026-02-30'}],['IRRELEVANT_HAS_FACTS',{classification:'IRRELEVANT'}],['AMBIGUITY_MISSING',{classification:'AMBIGUOUS'}],['INCOMPLETE_FACTS',{amount_minor:null}],['INCOMPLETE_ETA',{eta_precision:'UNKNOWN',new_eta_date:null}],['UNEXPECTED_AMOUNT_CHANGE',{amount_minor:4000}],['ETA_NOT_FULLY_FUTURE',{new_eta_date:'2026-10-06'}],['CONTRADICTORY_DELAY',{eta_precision:'EXACT_TIMESTAMP',new_eta_date:null,new_eta_exact:'2026-10-07T14:00:00.000Z'},'The payment is delayed until 14:00.'],['SOURCE_DATE_MISMATCH',{new_eta_date:'2026-10-13'}],['ALTERNATIVE_DATES_NOT_SINGLE_DATE',{},'The payment may arrive Monday or Tuesday.'],['UNKNOWN_SOURCE_INFLOW',{},'INFLOW-OTHER delayed until Monday.'],['SOURCE_CURRENCY_MISMATCH',{},'The EUR 4,000 receipt is delayed until Monday.'],['UNSUPPORTED_AMOUNT_CHANGE',{classification:'AMOUNT_CHANGED',amount_minor:350000}],['UNSUPPORTED_TIME_WINDOW',{eta_precision:'TIME_WINDOW',new_eta_date:null,eta_window_start:'2026-10-12T04:00:00.000Z',eta_window_end:'2026-10-13T04:00:00.000Z'}]
];
patches.forEach(([code,patch,text],i)=>test('fact rejection '+code+' '+i,async()=>{await rejected(envelope({...candidate(),...patch}),code,text);}));
test('unexpected keys are rejected without echo; required absent field is safe path',async()=>{const a=await rejected(envelope({...candidate(),'private-prompt-and-key':'private-value'}),'UNEXPECTED_FIELD');assert.equal(a.diagnostic!.field_path,'$.*');assert.ok(!JSON.stringify(a.diagnostic).includes('private-'));const c=candidate();delete c.currency;const b=await rejected(envelope(c),'MISSING_FIELD');assert.equal(b.diagnostic!.field_path,'currency');});
test('eventType, changeType, confidence and sourceText are never aliases for the domain contract',async()=>{for(const field of ['eventType','changeType','confidence','sourceText'])await rejected(envelope({...candidate(),[field]:'private-value'}),'UNEXPECTED_FIELD');});
test('case-only canonicalization is allowed but spelling, whitespace, IDs and amount are not guessed',async()=>{const r=await processFundingV2(mock(envelope({...candidate(),classification:'Delayed',currency:'usd',eta_precision:'date'})),hero,known,fixture(),reference,timezone,[]);assert.equal(r.candidate!.classification,'DELAYED');assert.equal(r.candidate!.currency,'USD');assert.equal(r.decision.decision,'ESCALATE');await rejected(envelope({...candidate(),classification:'Delayed '}),'UNSUPPORTED_EVENT_TYPE');await rejected(envelope({...candidate(),classification:'delay'}),'UNSUPPORTED_EVENT_TYPE');await rejected(envelope({...candidate(),expected_inflow_id:'inflow-001'}),'INVALID_INFLOW_ID');});
test('nullable irrelevant fields and explicit time windows preserve existing semantics',async()=>{const irrelevant=await processFundingV2(mock(envelope(emptyCandidate())),hero,known,fixture(),reference,timezone,[]);assert.equal(irrelevant.outcome,'NO_CHANGE');assert.equal(irrelevant.candidate!.currency,null);const c={...candidate(),eta_precision:'TIME_WINDOW',new_eta_date:null,eta_window_start:'2026-10-12T13:00:00.000Z',eta_window_end:'2026-10-12T15:00:00.000Z'};const r=await processFundingV2(mock(envelope(c)),'The payment arrives between 09:00 and 11:00 Monday.',known,fixture(),reference,timezone,[]);assert.equal(r.candidate!.eta_window_start,c.eta_window_start);assert.equal(r.candidate!.eta_window_end,c.eta_window_end);assert.equal(r.decision.decision,'ESCALATE');});
test('ambiguous update diagnoses review and does not change state',async()=>{const a=mock(envelope({...emptyCandidate('AMBIGUOUS'),ambiguities:['vague_time']})),input=fixture();const r=await processFundingV2(a,'The payment arrives soon.',known,input,reference,timezone,[]);assert.equal(a.diagnostic!.diagnostic_code,'AMBIGUOUS_UPDATE');assert.equal(r.diagnostic!.diagnostic_code,'AMBIGUOUS_UPDATE');assert.equal(r.input,input);assert.equal(r.outcome,'REJECTED');});
test('transport, HTTP and envelope decoding errors have distinct safe codes',async()=>{const cases:[typeof fetch,string][]=[[async()=>{throw new Error('private-network-message')},'NETWORK_FAILURE'],[async()=>{throw new DOMException('private','TimeoutError')},'REQUEST_TIMEOUT'],[async()=>new Response('private-error',{status:400}),'HTTP_ERROR'],[async()=>new Response('private-invalid-json'),'RESPONSE_JSON_FAILED']];for(const [transport,code] of cases){const a=new ClaudeFundingInterpreter({apiKey:'synthetic-test-key'},transport);await assert.rejects(a.interpret(hero,known,reference,timezone));assert.equal(a.diagnostic!.diagnostic_code,code);assert.ok(!JSON.stringify(a.diagnostic).includes('private'));}});
test('configuration/input/context validation rejects before any request',async()=>{let count=0;const transport:typeof fetch=async()=>{count++;throw Error();};for(const [config,text,k,ref,tz,code] of [[{},hero,known,reference,timezone,'CONFIGURATION_REQUIRED'],[{apiKey:'synthetic-test-key'},'',known,reference,timezone,'INVALID_INPUT'],[{apiKey:'synthetic-test-key'},hero,known,'bad',timezone,'INVALID_REFERENCE'],[{apiKey:'synthetic-test-key'},hero,known,reference,'private-invalid-zone','INVALID_CONTEXT'],[{apiKey:'synthetic-test-key'},hero,known,reference,'','TIMEZONE_REQUIRED'],[{apiKey:'synthetic-test-key'},hero,[{...known[0],currency:'BAD'}],reference,timezone,'INVALID_KNOWN_INFLOWS']] as const){const a=new ClaudeFundingInterpreter(config,transport);await assert.rejects(a.interpret(text,k,ref,tz));assert.equal(a.diagnostic!.diagnostic_code,code);}assert.equal(count,0);});
test('diagnostics expose only bounded metadata, never arbitrary block/stop/error text',async()=>{const a=await rejected({...payload,stop_reason:'private-stop',content:[{type:'private-type',text:'private-content'}]},'UNSUPPORTED_STOP_REASON');assert.equal(a.diagnostic!.stop_reason,'UNKNOWN');assert.deepEqual(a.diagnostic!.content_block_types,['UNKNOWN']);assert.deepEqual(Object.keys(a.diagnostic!).sort(),['status','model','stop_reason','content_block_types','parser_stage','diagnostic_code','field_path','reason','latency_ms'].sort());assert.ok(!JSON.stringify(a.diagnostic).includes('private'));assert.ok(!JSON.stringify(safeDiagnostic(new Error('secret arbitrary text'))).includes('secret'));});
test('all existing validator exceptions map to static diagnostic catalog entries',()=>{for(const file of ['src/funding-v2.mts','src/temporal.mts']){const s=readFileSync(file,'utf8');for(const match of s.matchAll(/throw new Error\('([A-Z_]+)'\)/g))assert.ok(Object.hasOwn(diagnosticCatalog,match[1]),match[1]);}for(const [code,value] of Object.entries(diagnosticCatalog)){const d=safeDiagnostic(new Error(code));assert.equal(d.diagnostic_code,code);assert.equal(d.parser_stage,value.stage);assert.ok(d.field_path);}});
test('application rejection paths preserve state and give exact reasons',()=>{const good=parseClaudeResponse(payload,hero,known,reference,timezone);const state=fixture().treasury;const checks:[object,object,string][]=[[{},{source_text_hash:'wrong'},'INVALID_PROVENANCE'],[{},{extracted_facts:[]},'INVALID_FACTS'],[{expected_inflow_id:'INFLOW-OTHER'},{},'APPLICATION_IDENTITY_MISMATCH'],[{source_currency:'EUR'},{},'APPLICATION_CURRENCY_MISMATCH'],[{expected_inflow_status:'received'},{},'INFLOW_NOT_APPLICABLE'],[{expected_inflow_amount:1n},{},'INFLOW_CONTEXT_MISMATCH']];for(const [stateChange,factChange,code] of checks){const input={...state,...stateChange};const r=applyFundingV2(input,{...good,...factChange},hero,known,reference,timezone,[]);assert.equal(r.state,input);assert.equal(r.diagnostic!.diagnostic_code,code);}const ontime=parseClaudeResponse(envelope({...candidate(),classification:'ON_TIME'}),hero,known,reference,timezone);const r=applyFundingV2(state,ontime,hero,known,reference,timezone,[]);assert.equal(r.diagnostic!.diagnostic_code,'ON_TIME_CONTEXT_MISMATCH');});
test('workflow clock, provenance and derived-fact failures retain safe codes',async()=>{const good=parseClaudeResponse(payload,hero,known,reference,timezone);for(const [returned,ref,code] of [[good,'2026-10-07T13:00:00.000Z','CLOCK_MISMATCH'],[{...good,source_text_hash:'bad'},reference,'INVALID_PROVENANCE'],[{...good,extracted_facts:[]},reference,'INVALID_FACTS']] as const){const input=fixture();const r=await processFundingV2({interpret:()=>({...returned,extracted_facts:[...returned.extracted_facts]})},hero,known,input,ref,timezone,[]);assert.equal(r.input,input);assert.equal(r.diagnostic!.diagnostic_code,code);}});
test('every envelope rejection leaves presentation unchanged and never invokes writes',async()=>{for(const [code,value] of contentCases){const dir=mkdtempSync(join(tmpdir(),'duegate-diag-'));try{const a=mock(value),s=new PresentationService(dir,undefined,{provider:'claude',interpreter:a});const before=await s.action('open');const after=await s.action('interpret',{text:hero});assert.equal(after.canApply,false);assert.equal(after.canExecute,false);assert.deepEqual(after.treasury,before.treasury);assert.equal(after.decision,before.decision);assert.equal(s.adapter.writeAttempts,0);const audit=readFileSync(join(dir,'interaction','audit.jsonl'),'utf8');assert.ok(audit.includes(code));assert.ok(audit.includes('stop_reason'));}finally{rmSync(dir,{recursive:true,force:true});}}});
